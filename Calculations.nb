Cell[TextData[{
 "\nThe trig expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"e4387975-fb61-47c8-b9f7-7d16a10dca20"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"96027943-f71d-4328-bae3-23dd2e0835eb"],
 ", and  Cos[4 ArcTan[x]] appears frequently in our code. Here, we define \
functions which can be used to simplify these expressions automatically. "
}], "Text",
 CellChangeTimes->{{3.949739423592511*^9, 3.9497394558185377`*^9}, {
   3.949933007006098*^9, 3.949933017778038*^9}, {3.949933057673617*^9, 
