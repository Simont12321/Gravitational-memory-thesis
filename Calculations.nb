f5a28f1f49b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SinSimp", "[", 
    RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"2", "*", 
     FractionBox["opp", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["adj", "2"], "+", 
        SuperscriptBox["opp", "2"]}], "]"}]], "*", 
     FractionBox["adj", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["adj", "2"], "+", 
        SuperscriptBox["opp", "2"]}], "]"}]]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Simplifies", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", 
      RowBox[{"ArcTan", "[", 
       FractionBox["opp", "adj"], "]"}]}], "]"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sin", 
     RowBox[{"(", 
      RowBox[{"2", "x"}], ")"}]}], " ", "=", " ", 
    RowBox[{"2", "CosxSinx"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CosSimp", "[", 
    RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["adj", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          SuperscriptBox["adj", "2"], "+", 
          SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["opp", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          SuperscriptBox["adj", "2"], "+", 
          SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Simplifies", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", 
      RowBox[{"ArcTan", "[", 
       FractionBox["opp", "adj"], "]"}]}], "]"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Cos", 
     RowBox[{"(", 
      RowBox[{"2", "x"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["Cos", "2"], 
      RowBox[{"(", "x", ")"}]}], " ", "-", " ", 
     RowBox[{
      SuperscriptBox["Sin", "2"], 
      RowBox[{"(", "x", ")"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CosSimp4AT", "[", 
   RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"8", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["adj", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "4"]}], "-", 
   RowBox[{"8", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["adj", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"]}], "+", "1", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"4", "x"}], "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "-", 
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "+", "1"}]}], ")"}], 
    "*)"}]}]}]}], "Input",
