Cell[CellGroupData[{

Cell["3D, Anisotropic, Plus-Polarised Wave", "Section",
 CellChangeTimes->{{3.9529765688754473`*^9, 3.952976601853015*^9}, {
  3.953299954535194*^9, 
  3.953299978252693*^9}},ExpressionUUID->"277984a6-d4f1-4a52-b6c6-\
a2eba909eb58"],

Cell[TextData[{
 "The plus polarized metric, P, is multiplied by a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"]}], ")"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2b61c29-e388-4ec5-9f37-17ce75721d37"],
 " (anisotropic) and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "R"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d000f91-c1b3-4213-be5c-e75eb4dc69f9"],
 " (distance) scaling factor. It is then rotated about the y-axis through an \
angle -\[Alpha] and then rotated about the x-axis through an angle \[Beta]. \
This gives the metric seen by a photon at a given time. "
}], "Text",
 CellChangeTimes->{{3.95330000263769*^9, 
  3.95330017216057*^9}},ExpressionUUID->"4d8f60a8-8ef6-4d61-bc0e-\
