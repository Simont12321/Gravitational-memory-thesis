     {
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"], "0", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]},
     {"0", 
      RowBox[{"-", "1"}], "0"},
