 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalEpsilon]", "[", "\[Alpha]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Ry", "[", 
     RowBox[{"-", "\[Alpha]"}], "]"}], ".", "P", ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Ry", "[", 
      RowBox[{"-", "\[Alpha]"}], "]"}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Polarization", " ", "of", " ", "a"}], " ", "+", " ", 
    RowBox[{"GW", " ", "at", " ", "an", " ", "angle", " ", "\[Alpha]"}]}], 
