Cell[CellGroupData[{

Cell["Other variables", "Subsubsection",
 CellChangeTimes->{{3.948381401786501*^9, 3.948381404378621*^9}, {
  3.94838149275209*^9, 
  3.948381497148493*^9}},ExpressionUUID->"a69917ee-c6e6-45f8-86f5-\
86875d1e3c4a"],

Cell["\<\
Constants: 
c=1, 
dG  Earth to GW source distance, 
tP time photon is received on Earth, 
tG time GW is received on Earth which we set to 0, 
(\[Phi],\[Theta]) location on Earth\[CloseCurlyQuote]s sky where the photon \
is received
h0 GW strain amplitude measured on Earth
t time as measured on Earth 

Functions:
Functions are capitalized. A is the function that gives \[Alpha] for given \
parameters, RP is the function that gives rP.  
rP distance from GW source to photon
\[Alpha] angle between GW source and photon (measured up from GW propegation \
vector)
dP distance from Earth to the photon
tmin initial time the photon encounters the GW
n vector pointing to point on the sky where the photon is found \
\>", "Text",
 CellChangeTimes->{{3.9483818145286427`*^9, 3.9483818401313877`*^9}, {
   3.948382307352519*^9, 3.948382336368888*^9}, {3.949343505271389*^9, 
   3.9493436366944523`*^9}, {3.949343688790551*^9, 3.949343779261691*^9}, {
   3.949343819240238*^9, 3.9493438639519663`*^9}, {3.949353300148061*^9, 
   3.949353306459661*^9}, {3.9493957322107067`*^9, 3.949395741443099*^9}, 
   3.949877911994422*^9},ExpressionUUID->"6be94856-62de-4cc8-87da-\
70bdcd3e0d05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"dG", ">", "0"}], "&&", 
    RowBox[{"h0", ">", "0"}], "&&", 
    RowBox[{"tP", ">", "tG"}], "&&", 
    RowBox[{"0", "<=", "\[Theta]", "<=", 
     RowBox[{"2", " ", "\[Pi]"}]}], "&&", 
    RowBox[{"t", "\[Element]", "Reals"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tG", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", 
    RowBox[{"dP_", ",", " ", "dG_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"dP", ">", "dG"}], ",", 
     RowBox[{"ArcCos", "[", 
      FractionBox["dG", "dP"], "]"}], ",", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=",
    "  ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[Theta]", "<=", 
      RowBox[{"M", "[", 
       RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"dP", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
        RowBox[{"dG", " ", "-", " ", 
         RowBox[{"dP", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
     ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Theta]", "<=", 
        RowBox[{
         RowBox[{"2", "\[Pi]"}], "-", 
         RowBox[{"M", "[", 
          RowBox[{"dP", ",", " ", "dG"}], "]"}]}]}], ",", 
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"dP", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{"dP", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"dG", " ", "-", " ", 
           RowBox[{"dP", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "-", 
        "\[Pi]"}]}], "]"}]}], "]"}]}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DP", "[", 
     RowBox[{"tP_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
    RowBox[{"c", 
     RowBox[{"(", 
      RowBox[{"tP", "-", "t"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DP", "[", 
    RowBox[{"tP_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"tP", ">", "t"}], ",", 
     RowBox[{"c", 
      RowBox[{"(", 
       RowBox[{"tP", "-", "t"}], ")"}]}], ",", " ", "0"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"if", " ", "tP"}], " ", ">", " ", "t"}], "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tmin", "[", 
   RowBox[{"tG_", ",", " ", "tP_", ",", " ", "dG_", ",", "\[Theta]_"}], "]"}],
   " ", ":=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "c"}], " ", 
     SuperscriptBox["tG", "2"]}], "+", 
    RowBox[{"2", " ", "dG", " ", "tG"}], " ", "+", 
    RowBox[{"c", " ", 
     SuperscriptBox["tP", "2"]}], " ", "-", " ", 
    RowBox[{"2", " ", "dG", " ", "tP", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", "c", " ", "tG"}], " ", "+", " ", 
    RowBox[{"2", " ", "dG"}], " ", "+", " ", 
    RowBox[{"2", " ", "c", " ", "tP"}], " ", "-", " ", 
    RowBox[{"2", " ", "dG", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "[", "\[Theta]_", "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RP", "[", 
   RowBox[{"dG_", ",", "tP_", ",", " ", "t_", ",", "\[Theta]_"}], "]"}], " ", 
  ":=", " ", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    SuperscriptBox["dG", "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"tP", "-", "t"}], ")"}], "2"], "-", 
    RowBox[{"2", " ", "dG", 
     RowBox[{"(", 
      RowBox[{"tP", "-", "t"}], ")"}], 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], " ", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"5", ",", "3", ",", "\[Theta]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", 
     RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", "\"\<\[Alpha]\>\""}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
