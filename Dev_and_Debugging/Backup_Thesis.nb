Cell["\<\
z stabilizes when tP >> dG. The photon is received (measure after GW \
received) long after the light-travel time to the GW source. \
\>", "Text",
 CellChangeTimes->{{3.949840819484926*^9, 3.9498408804102592`*^9}, 
   3.9498410182385273`*^9},ExpressionUUID->"b6b61d00-62d1-4f12-8015-\
0fb050b98357"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Z", "[", 
   RowBox[{"\[Theta]", ",", "dG", ",", "tP"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{
  3.949841086679348*^9, {3.94985787457826*^9, 3.94985797739351*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"854eba14-db16-48ca-9de5-c4ef8ad27b55"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], "dG"], "-", 
    FractionBox[
     RowBox[{
      SuperscriptBox["dG", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["dG", "2"], "-", 
        FractionBox[
         RowBox[{"dG", " ", "tP", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "dG"}], "+", "tP", "+", 
            RowBox[{"4", " ", "dG", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}]}], 
         RowBox[{"dG", "+", "tP", "+", 
          RowBox[{"dG", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "+", 
        FractionBox[
         RowBox[{
          SuperscriptBox["tP", "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "dG"}], "+", "tP", "+", 
             RowBox[{"4", " ", "dG", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"]}], 
         RowBox[{"4", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"dG", "+", "tP", "+", 
             RowBox[{"dG", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"]}]]}], 
       ")"}], 
      RowBox[{"3", "/", "2"}]]]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.9498410869284678`*^9, {3.9498579245032*^9, 3.94985798260052*^9}},
 CellLabel->"Out[15]=",ExpressionUUID->"085b9569-b7df-4ae6-8870-56b923241f82"]
}, Open  ]],

