  3.9498397184968*^9}},ExpressionUUID->"a9df6713-16c7-4d9a-b45a-40e30dadb450"],

Cell["\<\
Testing 3D case of a +-polarized wave with a general looking vector v = {Sin[\
\[Theta]]Cos[\[Phi]], Sin[\[Theta]]Sin[\[Phi]], Cos[\[Theta]]} \
\>", "Text",
 CellChangeTimes->{{3.94991904992979*^9, 3.949919050608142*^9}, {
  3.949919144143477*^9, 3.949919159526409*^9}, {3.949925871729035*^9, 
  3.949925911429125*^9}},ExpressionUUID->"a440e6da-b91f-4f67-8e4a-\
a79db991030c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intR", " ", "=", " ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "[", "\[Theta]", "]"}], ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"n", "[", "\[Theta]", "]"}], ".", "\[Epsilon]r"}], "]"}]}], 
    " ", "*", 
    FractionBox["1", 
     RowBox[{"RP", "[", 
      RowBox[{"dG", ",", "tP", ",", " ", "t", ",", "\[Theta]"}], "]"}]]}], 
   "]"}], 
  RowBox[{"(*", 
   RowBox[{"rotated", " ", 
    RowBox[{"integrand", ".", " ", "applying"}], " ", 
    SuperscriptBox["n", "i"], 
    SuperscriptBox["n", "j"], " ", "and", " ", "then", " ", "applying", " ", 
    FractionBox["1", "Rp"]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.949853801970717*^9, 3.9498538284284277`*^9}, {
  3.949853984336939*^9, 3.9498540419673223`*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"d898f1a5-2a76-4cfb-be96-1c352befdeba"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["dG", "2"], " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"2", " ", "\[Phi]"}], "]"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["dG", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
     RowBox[{"2", " ", "dG", " ", 
      RowBox[{"(", 
       RowBox[{"t", "-", "tP"}], ")"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], 
   RowBox[{"3", "/", "2"}]]]], "Output",
 CellChangeTimes->{{3.949853806433393*^9, 3.9498538304606667`*^9}, 
   3.949854046496331*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"e68fb69b-7e96-4bd7-981f-09fdfaa225e9"]
}, Open  ]],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{
  3.949919552086446*^9},ExpressionUUID->"1e0e1c86-dfb4-412b-a8dd-\
6d879fb8cf69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Epsilon]3d", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Rz", "[", "\[Phi]", "]"}], ".", 
      RowBox[{"Ry", "[", 
       RowBox[{"-", "\[Alpha]"}], "]"}], ".", "P", ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Ry", "[", 
        RowBox[{"-", "\[Alpha]"}], "]"}], "]"}]}], "]"}], ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Rz", "[", "\[Phi]", "]"}], "]"}]}], " ", "//", "MatrixForm", 
