Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"-", 
              FractionBox[
               RowBox[{"Abs", "[", 
                RowBox[{"dG", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t", "-", "tP"}], ")"}], " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "]"}], 
               RowBox[{
                SuperscriptBox["dG", "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
                RowBox[{"2", " ", "dG", " ", 
                 RowBox[{"(", 
                  RowBox[{"t", "-", "tP"}], ")"}], " ", 
                 RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "\[GreaterEqual]", "tP"}], "||", 
                RowBox[{"\[Theta]", "\[LessEqual]", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["dG", 
                   RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], "||", 
                RowBox[{
                 RowBox[{"\[Theta]", "+", 
                  RowBox[{"ArcCos", "[", 
                   FractionBox["dG", 
                    RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], ">", 
                 RowBox[{"2", " ", "\[Pi]"}]}]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
