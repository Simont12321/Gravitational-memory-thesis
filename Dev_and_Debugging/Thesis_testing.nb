Cell["\<\
Rotation matrices applied to GW polarization tensors for a GW traveling along \
the z-axis. \
\>", "Subsubsection",
 CellChangeTimes->{{3.948114948540784*^9, 3.9481149593091993`*^9}, {
  3.9481153825831127`*^9, 
  3.948115392276525*^9}},ExpressionUUID->"2b993ca7-fb36-4266-aa44-\
9b6318fb4a55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rz", "[", "\[Phi]_", "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", " ", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", "0"}], "}"}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", " ", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], " ", 
  RowBox[{"(*", 
   RowBox[{"z", "-", 
    RowBox[{"axis", " ", "rotation"}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.940786159000349*^9, 3.940786219650237*^9}, {
   3.940786500245592*^9, 3.940786502012724*^9}, 3.948114738897912*^9, {
   3.948114961352447*^9, 3.948114966189487*^9}},
 CellLabel->
  "In[431]:=",ExpressionUUID->"359ed83e-b4b7-465f-beeb-741b92562537"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"+", " ", "polarized"}], " ", "wave"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "x", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "p"}], ",", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"general", " ", "wave", " ", "polarization"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"X", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"cross", " ", "polarized", " ", "wave"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.948114968068153*^9, 3.948114972315507*^9}, {
  3.949319749726163*^9, 3.949319749863236*^9}},
 CellLabel->
  "In[432]:=",ExpressionUUID->"384a748e-fb6c-4fcb-be09-647f60b35c4f"],

Cell[TextData[{
 "Applying the rotation matrix to + polarization. Tensors rotate as T\
\[CloseCurlyQuote] = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["RTR", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "20b6b43b-d94f-44b2-bc9a-ab6329a6b8d8"],
 "\nTo get the new tensor you apply the rotation matrix R and its inverse ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "dec1f92c-60db-49f0-919e-c449c53303a9"]
}], "Text",
 CellChangeTimes->{{3.9481152739198313`*^9, 3.9481153610204782`*^9}, {
  3.950397830851967*^9, 
  3.950397836143805*^9}},ExpressionUUID->"355affa1-ff21-4ddc-ae61-\
82e22c80d8ab"],

