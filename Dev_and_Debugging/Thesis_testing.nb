           RowBox[{"(", 
            RowBox[{
             RowBox[{"2.`", " ", 
              SuperscriptBox["t", "2"]}], "-", 
             RowBox[{"4.`", " ", "t", " ", "tP"}], "+", 
             RowBox[{"2.`", " ", 
              SuperscriptBox["tP", "2"]}]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"1.`", " ", 
              SuperscriptBox["t", "2"]}], "-", 
             RowBox[{"2.`", " ", "t", " ", "tP"}], "+", 
             RowBox[{"1.`", " ", 
              SuperscriptBox["tP", "2"]}]}], ")"}], " ", 
