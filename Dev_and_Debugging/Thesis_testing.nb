Cell[BoxData[
 RowBox[{
  RowBox[{"hp3dfirst", " ", "=", " ", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"dG", "+", 
            RowBox[{
