Cell[BoxData[
 RowBox[{
  RowBox[{"Z3dfull", "[", 
   RowBox[{
   "\[Theta]_", ",", " ", "dG_", ",", " ", "tP_", ",", " ", "hM_", ",", " ", 
    "\[Phi]_"}], "]"}], " ", ":=", " ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Theta]", "\[LessEqual]", 
         RowBox[{"ArcCos", "[", 
          FractionBox["dG", 
           RowBox[{"tP", "-", 
            FractionBox[
             RowBox[{
              SuperscriptBox["tP", "2"], "-", 
              RowBox[{"2", " ", "dG", " ", "tP", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
             RowBox[{
              RowBox[{"2", " ", "dG"}], "+", 
              RowBox[{"2", " ", "tP"}], "-", 
              RowBox[{"2", " ", "dG", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}]], "]"}]}], "||", 
        RowBox[{
         RowBox[{"\[Theta]", "+", 
          RowBox[{"ArcCos", "[", 
           FractionBox["dG", 
            RowBox[{"tP", "-", 
             FractionBox[
              RowBox[{
               SuperscriptBox["tP", "2"], "-", 
               RowBox[{"2", " ", "dG", " ", "tP", " ", 
                RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
              RowBox[{
               RowBox[{"2", " ", "dG"}], "+", 
               RowBox[{"2", " ", "tP"}], "-", 
               RowBox[{"2", " ", "dG", " ", 
                RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}]], "]"}]}], ">", 
         RowBox[{"2", " ", "\[Pi]"}]}]}], ")"}], "&&", 
      RowBox[{
       RowBox[{"dG", "+", 
        FractionBox[
         RowBox[{
          SuperscriptBox["tP", "2"], "-", 
          RowBox[{"2", " ", "dG", " ", "tP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
         RowBox[{
          RowBox[{"2", " ", "dG"}], "+", 
          RowBox[{"2", " ", "tP"}], "-", 
          RowBox[{"2", " ", "dG", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], "<", "tP"}]}], ")"}],
     ",", " ", 
    RowBox[{"Z3dcond", "[", 
     RowBox[{
     "\[Theta]", ",", " ", "dG", ",", " ", "tP", ",", " ", "hM", ",", " ", 
      "\[Phi]"}], "]"}], ",", 
    RowBox[{"Z3d2", "[", 
     RowBox[{
     "\[Theta]", ",", " ", "dG", ",", " ", "tP", ",", " ", "hM", ",", " ", 
