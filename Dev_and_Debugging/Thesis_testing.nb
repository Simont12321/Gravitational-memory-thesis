           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}], "2"]], 
      "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"t", "-", "tP"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", 
            RowBox[{"ArcTan", "[", 
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
               RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
