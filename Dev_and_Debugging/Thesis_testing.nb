            RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["dG", "2"], "+", 
          RowBox[{"dG", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2.`", " ", "t"}], "-", 
             RowBox[{"2.`", " ", "tP"}]}], ")"}], " ", 
