          SuperscriptBox["tP", "2"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "dG"}], "+", "tP"}], ")"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"dG", "+", 
            FractionBox[
             RowBox[{"tP", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "dG"}], "+", "tP"}], ")"}], " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", 
               RowBox[{"(", 
                RowBox[{"dG", "+", "tP"}], ")"}]}], "+", 
              RowBox[{"2", " ", "dG", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], ")"}], "2"], "+", 
