                    ")"}]}]]}]]}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "\[GreaterEqual]", "tP"}], "||", 
                RowBox[{"\[Theta]", "\[LessEqual]", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["dG", 
                   RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], "||", 
                RowBox[{
                 RowBox[{"\[Theta]", "+", 
