                    RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], ">", 
                 RowBox[{"2", " ", "\[Pi]"}]}]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "<", "tP"}], "||", 
                RowBox[{"\[Theta]", "\[LessEqual]", "0"}]}], ")"}]}]},
            {
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"t", "-", "tP"}], ")"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
               RowBox[{"Sin", "[", 
