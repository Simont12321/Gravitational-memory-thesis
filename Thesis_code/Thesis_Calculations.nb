Cell[CellGroupData[{

Cell["Variables and Functions", "Subsection",
 CellChangeTimes->{{3.948381401786501*^9, 3.948381404378621*^9}, {
   3.94838149275209*^9, 3.948381497148493*^9}, 3.950307604865713*^9, 
   3.950307638114027*^9, {3.953295811302524*^9, 
   3.953295814708253*^9}},ExpressionUUID->"09a40e9b-2aef-4507-afd3-\
4ba966731202"],

Cell["\<\
Constants: 
c=1, 
dG  Earth to GW source distance, 
tP time photon is received on Earth, 
tG time GW is received on Earth which we set to 0, 
(\[Phi],\[Theta]) location on Earth\[CloseCurlyQuote]s sky where the photon \
is received
h0 GW strain amplitude measured on Earth
t time as measured on Earth 

Functions:
Functions are capitalized. A is the function that gives \[Alpha] for given \
parameters, RP is the function that gives rP.  
rP is the distance from GW source to photon
\[Alpha] is the angle between GW source and photon (measured up from GW \
propegation vector)
\[Beta] is the azimuthal angle from the GW source to the photon 
dP is the distance from Earth to the photon
tmin is the initial time the photon encounters the GW
n is the vector pointing to point on the sky where the photon is found \
\>", "Text",
 CellChangeTimes->{{3.9483818145286427`*^9, 3.9483818401313877`*^9}, {
   3.948382307352519*^9, 3.948382336368888*^9}, {3.949343505271389*^9, 
   3.9493436366944523`*^9}, {3.949343688790551*^9, 3.949343779261691*^9}, {
   3.949343819240238*^9, 3.9493438639519663`*^9}, {3.949353300148061*^9, 
   3.949353306459661*^9}, {3.9493957322107067`*^9, 3.949395741443099*^9}, 
   3.949877911994422*^9, {3.953295272299224*^9, 3.953295285501466*^9}, {
   3.9532953195211487`*^9, 3.9532953272430353`*^9}, {3.953295360667828*^9, 
   3.9532953682961607`*^9}},ExpressionUUID->"5faffb45-8e33-4e61-99d9-\
5b7c0b8ec86d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"dG", ">", "0"}], "&&", 
    RowBox[{"h0", ">", "0"}], "&&", 
    RowBox[{"tP", ">", "tG"}], "&&", 
    RowBox[{"0", "<=", "\[Theta]", "<=", 
     RowBox[{"2", " ", "\[Pi]"}]}], "&&", 
    RowBox[{"t", "\[Element]", "Reals"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tG", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"M", "[", 
     RowBox[{"dP_", ",", " ", "dG_"}], "]"}], " ", ":=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"dP", ">", "dG"}], ",", 
      RowBox[{"ArcCos", "[", 
       FractionBox["dG", "dP"], "]"}], ",", "0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=",
     "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"\[Theta]", "<=", 
       RowBox[{"M", "[", 
        RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"dP", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
      ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Theta]", "<=", 
         RowBox[{
          RowBox[{"2", "\[Pi]"}], "-", 
          RowBox[{"M", "[", 
           RowBox[{"dP", ",", " ", "dG"}], "]"}]}]}], ",", 
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{"dP", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
          RowBox[{"dG", " ", "-", " ", 
           RowBox[{"dP", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
        RowBox[{
         RowBox[{"ArcTan", "[", 
          FractionBox[
           RowBox[{"dP", " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
           RowBox[{"dG", " ", "-", " ", 
            RowBox[{"dP", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "-", 
         "\[Pi]"}]}], "]"}]}], "]"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"DP", "[", 
    RowBox[{"tP_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{"c", 
    RowBox[{"(", 
     RowBox[{"tP", "-", "t"}], ")"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DP", "[", 
     RowBox[{"tP_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"tP", ">", "t"}], ",", 
      RowBox[{"c", 
       RowBox[{"(", 
        RowBox[{"tP", "-", "t"}], ")"}]}], ",", " ", "0"}], "]"}]}], "*)"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"solves", " ", "for", " ", "if", " ", "tP"}], " ", ">", " ", 
     "t"}], ",", " ", 
    RowBox[{"but", " ", 
     RowBox[{"shouldn", "'"}], "t", " ", "be", " ", "needed"}], ",", " ", 
    RowBox[{
    "although", " ", "it", " ", "did", " ", "change", " ", "the", " ", 
     "\[Epsilon]", " ", "and", " ", "h", " ", "expresions", " ", "a", " ", 
     "little"}]}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tmin", "[", 
   RowBox[{"tG_", ",", " ", "tP_", ",", " ", "dG_", ",", "\[Theta]_"}], "]"}],
   " ", ":=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "c"}], " ", 
     SuperscriptBox["tG", "2"]}], "+", 
    RowBox[{"2", " ", "dG", " ", "tG"}], " ", "+", 
    RowBox[{"c", " ", 
     SuperscriptBox["tP", "2"]}], " ", "-", " ", 
    RowBox[{"2", " ", "dG", " ", "tP", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", "c", " ", "tG"}], " ", "+", " ", 
    RowBox[{"2", " ", "dG"}], " ", "+", " ", 
    RowBox[{"2", " ", "c", " ", "tP"}], " ", "-", " ", 
    RowBox[{"2", " ", "dG", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RP", "[", 
   RowBox[{"dG_", ",", "tP_", ",", " ", "t_", ",", "\[Theta]_"}], "]"}], " ", 
  ":=", " ", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    SuperscriptBox["dG", "2"], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"tP", "-", "t"}], ")"}], "2"], "-", 
    RowBox[{"2", " ", "dG", 
     RowBox[{"(", 
      RowBox[{"tP", "-", "t"}], ")"}], 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], " ", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "\[Theta]_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", " ", "0", ",", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"2", "D", " ", "looking", " ", "vectore", " ", "in", " ", 
    RowBox[{"x", "/", "z"}], " ", "plane"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "[", 
   RowBox[{"\[Theta]_", ",", " ", "\[Phi]_"}], "]"}], " ", ":=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], 
     RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Theta]", "]"}], 
     RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], " ", 
  RowBox[{"(*", 
   RowBox[{"3", "D", " ", "looking", " ", "vector"}], " ", "*)"}]}]}], "Input",\

 CellChangeTimes->{{3.948382672084339*^9, 3.948382677070463*^9}, {
   3.9490720004393663`*^9, 3.949072008236423*^9}, {3.9493190296866903`*^9, 
