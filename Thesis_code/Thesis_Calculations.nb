                   RowBox[{"t", "-", "tP"}], ")"}], " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
               RowBox[{"Sign", "[", 
                RowBox[{"dG", "+", 
                 RowBox[{
                  RowBox[{"(", 
