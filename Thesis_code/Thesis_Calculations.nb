       SuperscriptBox["\[Theta]", "2"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", "-", "tP"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], " ", 
       SuperscriptBox["\[Theta]", "2"], " ", 
       RowBox[{"(", 
