Cell[CellGroupData[{

Cell["3D, Anisotropic, Plus-Polarised Wave: Work in Progress", "Section",
 CellChangeTimes->{{3.9529765688754473`*^9, 3.952976601853015*^9}, {
  3.953299954535194*^9, 3.953299978252693*^9}, {3.9548897130318823`*^9, 
  3.954889717891814*^9}},ExpressionUUID->"277984a6-d4f1-4a52-b6c6-\
a2eba909eb58"],

Cell[TextData[{
 "The plus polarized metric, P, is multiplied by a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "2"]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"e2b61c29-e388-4ec5-9f37-17ce75721d37"],
 " (anisotropic) and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "R"}], TraditionalForm]],ExpressionUUID->
  "5d000f91-c1b3-4213-be5c-e75eb4dc69f9"],
 " (distance) scaling factor. It is then rotated about the y-axis through an \
angle -\[Alpha] and then rotated about the x-axis through an angle \[Beta]. \
This gives the metric seen by a photon at a given time. \nWork in progress: \
We will be updating the anisotropic scaling factor. "
}], "Text",
 CellChangeTimes->{{3.95330000263769*^9, 3.95330017216057*^9}, {
  3.954889690401539*^9, 
  3.95488970738008*^9}},ExpressionUUID->"4d8f60a8-8ef6-4d61-bc0e-\
2a1b707e279e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h3DAniso", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Rx", "[", 
      RowBox[{"B", "[", 
       RowBox[{
        RowBox[{"DP", "[", 
         RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
        "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], ".", 
     RowBox[{"Ry", "[", 
      RowBox[{"-", 
       RowBox[{"A", "[", 
        RowBox[{
         RowBox[{"DP", "[", 
          RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
         "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}], ".", 
     FractionBox[
      RowBox[{"P", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           RowBox[{"A", "[", 
            RowBox[{
             RowBox[{"DP", "[", 
              RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
             "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], "2"]}], ")"}]}], 
      RowBox[{"2", "*", 
       RowBox[{"RP", "[", 
        RowBox[{"dG", ",", "tP", ",", " ", "t", ",", "\[Theta]"}], "]"}]}]], 
     ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Ry", "[", 
       RowBox[{"-", 
        RowBox[{"A", "[", 
         RowBox[{
          RowBox[{"DP", "[", 
           RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
          "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}], "]"}], ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rx", "[", 
       RowBox[{"B", "[", 
        RowBox[{
         RowBox[{"DP", "[", 
          RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
         "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "h3DAniso", "]"}]}], "Input",
 CellChangeTimes->{{3.951691838878293*^9, 3.9516919105445766`*^9}, {
  3.951691942525175*^9, 3.9516919813067417`*^9}, {3.951692123748617*^9, 
