Cell[TextData[{
 "There are no tP\[CloseCurlyQuote]s in the nnhDefIntGT or nnhDefIntLT \
expressions, but there are some dG\[CloseCurlyQuote]s. I think they cancel. \
There are some cases where it says  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox["dG", "2"]}], "]"}], ","}]],
  CellChangeTimes->{3.965313639944759*^9},ExpressionUUID->
  "3c54c9ba-b72f-4aba-9105-7abfcb6f9c9e"],
 " but the argument of Log has to be unit-less. "
}], "Text",
 CellChangeTimes->{{3.965314216177174*^9, 3.965314249481977*^9}, {
