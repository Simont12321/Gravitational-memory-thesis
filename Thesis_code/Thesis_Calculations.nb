   RowBox[{"\[Theta]", "\[LessEqual]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "t"}], "+", "tP"}], ">", "dG"}], ",", 
