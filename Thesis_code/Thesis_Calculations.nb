Cell["\<\
we need to redefine nnhijApprox to calculate the deflection angle so it has \
the variables tP, \[Theta], and \[Phi]\
\>", "Text",
 CellChangeTimes->{{3.968165119467613*^9, 
  3.968165146155161*^9}},ExpressionUUID->"d22b040e-092d-47a8-a622-\
d325293232dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nnhijApproxAgl", "[", 
   RowBox[{
   "t_", ",", " ", "tP_", ",", " ", "\[Theta]_", ",", " ", "\[Phi]_"}], "]"}],
   " ", ":=", " ", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"Abs", "[", 
     RowBox[{"dG", "+", "t", "-", "tP"}], "]"}]], "dG", " ", 
   SuperscriptBox["\[Theta]", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"1.`", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "1.`"}], " ", "t"}], "+", 
            RowBox[{"1.`", " ", "tP"}]}], ">", "dG"}], ",", 
          RowBox[{"\[Pi]", "-", 
           RowBox[{"ArcTan", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1.`", " ", 
