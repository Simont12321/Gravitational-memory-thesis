         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{"dP", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
          RowBox[{"dG", " ", "-", " ", 
           RowBox[{"dP", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "-", 
        "\[Pi]"}]}], "]"}]}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "[", 
   RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_", ",", "\[Phi]_"}], 
   "]"}], " ", ":=", "  ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"\[Theta]", "<=", 
     RowBox[{"M", "[", 
      RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      FractionBox[
       RowBox[{"dP", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
       RowBox[{"dG", " ", "-", " ", 
        RowBox[{"dP", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
    ",", 
    RowBox[{"If", "[", 
