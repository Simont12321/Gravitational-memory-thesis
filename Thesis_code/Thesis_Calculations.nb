Cell[CellGroupData[{

Cell["Basic metric, radially decreasing, times dG", "Subsection",
 CellChangeTimes->{{3.967896792733775*^9, 
  3.967896802152687*^9}},ExpressionUUID->"74a6f5ab-02f5-4270-8cb5-\
fba6d722d1f1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h3DIso", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Rx", "[", 
      RowBox[{"B", "[", 
       RowBox[{
        RowBox[{"DP", "[", 
         RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
        "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], ".", 
     RowBox[{"Ry", "[", 
      RowBox[{"-", 
       RowBox[{"A", "[", 
        RowBox[{
