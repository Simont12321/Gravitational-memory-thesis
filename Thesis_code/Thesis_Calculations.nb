        RowBox[{"TimeConstraint", "->", "1"}], ",", 
        RowBox[{"ComplexityFunction", "\[Rule]", "LeafCount"}]}], "]"}], ",", 
      " ", 
      RowBox[{"TimeConstraint", "->", "10"}], ",", " ", 
