Cell[CellGroupData[{

Cell["Variables and Functions", "Subsection",
 CellChangeTimes->{{3.948381401786501*^9, 3.948381404378621*^9}, {
   3.94838149275209*^9, 3.948381497148493*^9}, 3.950307604865713*^9, 
