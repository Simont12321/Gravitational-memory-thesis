Cell[BoxData[
 RowBox[{
  RowBox[{"\[Chi]Approx", "[", 
   RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_", ",", "\[Phi]_"}], 
   "]"}], " ", ":=", "  ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"\[Theta]", "<=", 
     RowBox[{"M", "[", 
      RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      FractionBox[
       RowBox[{"dP", " ", "\[Theta]"}], 
       RowBox[{"dG", " ", "-", " ", 
        RowBox[{"dP", " ", "1"}]}]], "]"}], "+", "\[Pi]"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"\[Theta]", "<=", 
       RowBox[{
        RowBox[{"2", "\[Pi]"}], "-", 
        RowBox[{"M", "[", 
         RowBox[{"dP", ",", " ", "dG"}], "]"}]}]}], ",", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"dP", " ", "\[Theta]"}], 
        RowBox[{"dG", " ", "-", " ", 
         RowBox[{"dP", " ", "1"}]}]], "]"}], ",", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"dP", " ", "\[Theta]"}], 
         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", "1"}]}]], "]"}], "-", "\[Pi]"}]}], "]"}]}], 
   "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "approx", " ", "angle", " ", "between", " ", "n", " ", "and", " ", "R"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.954427282501693*^9, 3.9544272946061974`*^9}, {
