Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h3DIso", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Rx", "[", 
      RowBox[{"B", "[", 
       RowBox[{
        RowBox[{"DP", "[", 
         RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
        "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], ".", 
     RowBox[{"Ry", "[", 
      RowBox[{"-", 
       RowBox[{"A", "[", 
        RowBox[{
         RowBox[{"DP", "[", 
          RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
         "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}], ".", 
     FractionBox["P", 
      RowBox[{"RP", "[", 
       RowBox[{"dG", ",", "tP", ",", " ", "t", ",", "\[Theta]"}], "]"}]], ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Ry", "[", 
       RowBox[{"-", 
        RowBox[{"A", "[", 
         RowBox[{
          RowBox[{"DP", "[", 
           RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
          "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}], "]"}], ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rx", "[", 
       RowBox[{"B", "[", 
        RowBox[{
         RowBox[{"DP", "[", 
          RowBox[{"tP", ",", "t"}], "]"}], ",", " ", "dG", ",", " ", 
         "\[Theta]", ",", "\[Phi]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MatrixForm", "[", "h3DIso", "]"}], "    "}]}], "Input",
 CellChangeTimes->{{3.954621559587624*^9, 3.954621599060254*^9}, {
  3.961494756097632*^9, 
  3.961494757106421*^9}},ExpressionUUID->"72fcdada-41bc-4830-a137-\
d86c7ebf59cf"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"dG", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"], 
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["dG", "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
          RowBox[{"2", " ", "dG", " ", 
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["dG", "2"], "+", 
          RowBox[{"2", " ", "dG", " ", 
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}]], 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{"-", 
              FractionBox[
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"t", "-", "tP"}], ")"}], " ", 
                RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
                RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", " ", 
                  RowBox[{"ArcTan", "[", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
                    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
                    RowBox[{"dG", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}]}], 
                 "]"}]}], 
               RowBox[{"2", " ", 
                RowBox[{"(", 
                 RowBox[{"dG", "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                   RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
                SqrtBox[
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["dG", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
                    RowBox[{"2", " ", "dG", " ", 
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    FractionBox[
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"dG", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "2"]]}],
                    ")"}]}]]}]]}], 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "\[GreaterEqual]", "tP"}], "||", 
                RowBox[{"\[Theta]", "\[LessEqual]", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["dG", 
                   RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], "||", 
                RowBox[{
                 RowBox[{"\[Theta]", "+", 
                  RowBox[{"ArcCos", "[", 
                   FractionBox["dG", 
                    RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], ">", 
                 RowBox[{"2", " ", "\[Pi]"}]}]}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "<", "tP"}], "||", 
                RowBox[{"\[Theta]", "\[LessEqual]", "0"}]}], ")"}]}]},
            {
             FractionBox[
              RowBox[{
               RowBox[{"(", 
                RowBox[{"t", "-", "tP"}], ")"}], " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
               RowBox[{"Sin", "[", "\[Phi]", "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"2", " ", 
                 RowBox[{"ArcTan", "[", 
                  FractionBox[
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
                    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
                   RowBox[{"dG", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}]}], 
                "]"}]}], 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"dG", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t", "-", "tP"}], ")"}], " ", 
                  RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
               SqrtBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox["dG", "2"], "+", 
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
                   RowBox[{"2", " ", "dG", " ", 
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   FractionBox[
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], 
                    SuperscriptBox[
                    RowBox[{"(", 
