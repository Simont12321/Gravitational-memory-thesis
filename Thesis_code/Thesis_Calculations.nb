Cell[CellGroupData[{

Cell["Deflection angle (small \[Theta] approximation)", "Subsection",
 CellChangeTimes->{{3.9628808222840137`*^9, 3.962880824595809*^9}, {
  3.96288087772792*^9, 
  3.96288088370571*^9}},ExpressionUUID->"aae6ed1e-48f0-4d2a-a80a-\
65e904f3874b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"H3DIsoApprox", "[", 
    RowBox[{
    "t_", ",", " ", "tP_", ",", " ", "\[Theta]_", ",", " ", "\[Phi]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], "2"], " ", 
       SuperscriptBox["\[Theta]", "2"], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Phi]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"t", "-", "tP"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], " ", 
       SuperscriptBox["\[Theta]", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], "2"], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
          SuperscriptBox["\[Theta]", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], "+", 
      RowBox[{"\[Theta]", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{"dG", "+", "t", "-", "tP"}], "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], "2"], "+", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
          SuperscriptBox["\[Theta]", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], ")"}], " ", 
       RowBox[{"(", 
        TagBox[GridBox[{
           {"\[Piecewise]", GridBox[{
              {
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"t", "-", "tP"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], " ", "\[Theta]",
                  " ", 
                 RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], "2"], "+", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
                    SuperscriptBox["\[Theta]", "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], ")"}], " ", 
                 SqrtBox[
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"dG", "+", "t", "-", "tP"}], ")"}], "2"], "+", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
                    SuperscriptBox["\[Theta]", "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}]}]]}]], 
               RowBox[{
                RowBox[{"\[Theta]", "\[LessEqual]", 
                 RowBox[{"ArcCos", "[", 
                  FractionBox["dG", 
                   RowBox[{
                    RowBox[{"-", "t"}], "+", "tP"}]], "]"}]}], "&&", 
                RowBox[{
                 RowBox[{"dG", "+", "t"}], "<", "tP"}]}]},
              {
               RowBox[{"-", 
