       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "4"]}], "-", 
   RowBox[{"8", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["adj", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"]}], "+", "1", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"4", "x"}], "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "-", 
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "+", "1"}]}], ")"}], 
    "*)"}]}]}]}], "Input",
