  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "a", " ", "polar", " ", "plot", " ", "of", " ", 
     "the", " ", "total", " ", "amout", " ", "of", " ", "time", " ", "a", " ",
