Cell[TextData[{
 "Discontinuity when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"dG", "/", "tP"}], " ", ">", " ", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "741b8a71-f4cf-48de-945c-a5659ec3a900"],
 " for a max \[Theta] of 0.3. It might be physical, from the instant \
heavystep function? \nExample: dG = 19.6, tP = 0.45, \[Phi] = 0, cutoff at \
\[Theta]=0.15 "
}], "Text",
