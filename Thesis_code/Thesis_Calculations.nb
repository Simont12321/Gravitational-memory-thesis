        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
   ",", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[Theta]", "\[LessEqual]", 
      RowBox[{
       RowBox[{"2", " ", "\[Pi]"}], "-", 
       RowBox[{"M", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "t"}], "+", "tP"}], ",", "dG"}], "]"}]}]}], ",", 
     RowBox[{"ArcTan", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
       RowBox[{"dG", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
     RowBox[{
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "t"}], "+", "tP"}], ")"}], " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
