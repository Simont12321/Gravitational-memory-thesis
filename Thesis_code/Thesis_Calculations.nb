Cell["\<\

Functions for \[Alpha] and \[Beta], which are related to polar angles in the \
GW source\[CloseCurlyQuote]s coordinate system. These are the angles we \
rotate through to relate the polarization metric seen at Earth to the \
polarization metric seen by a photon at a given time. \
\>", "Text",
 CellChangeTimes->{{3.9532958248852158`*^9, 3.953295887757165*^9}, {
   3.953295936555504*^9, 3.953295982337126*^9}, 
   3.953296326740655*^9},ExpressionUUID->"c0ae379f-8492-4354-9f62-\
4cc2e8fb4626"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_", ",", "\[Phi]_"}], 
    "]"}], " ", ":=", "  ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[Theta]", "<=", 
      RowBox[{"M", "[", 
       RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"dP", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
        RowBox[{"dG", " ", "-", " ", 
         RowBox[{"dP", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
     ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Theta]", "<=", 
        RowBox[{
         RowBox[{"2", "\[Pi]"}], "-", 
         RowBox[{"M", "[", 
          RowBox[{"dP", ",", " ", "dG"}], "]"}]}]}], ",", 
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"dP", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
       RowBox[{
        RowBox[{"ArcTan", "[", 
         FractionBox[
          RowBox[{"dP", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], 
          RowBox[{"dG", " ", "-", " ", 
           RowBox[{"dP", " ", 
            RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "-", 
        "\[Pi]"}]}], "]"}]}], "]"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "[", 
   RowBox[{"dP_", ",", " ", "dG_", ",", " ", "\[Theta]_", ",", "\[Phi]_"}], 
   "]"}], " ", ":=", "  ", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"\[Theta]", "<=", 
     RowBox[{"M", "[", 
      RowBox[{"dP", ",", " ", "dG"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"ArcTan", "[", 
      FractionBox[
       RowBox[{"dP", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
       RowBox[{"dG", " ", "-", " ", 
        RowBox[{"dP", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "+", "\[Pi]"}], 
    ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"\[Theta]", "<=", 
       RowBox[{
        RowBox[{"2", "\[Pi]"}], "-", 
        RowBox[{"M", "[", 
         RowBox[{"dP", ",", " ", "dG"}], "]"}]}]}], ",", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        RowBox[{"dP", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
        RowBox[{"dG", " ", "-", " ", 
         RowBox[{"dP", " ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], ",", 
      RowBox[{
       RowBox[{"ArcTan", "[", 
        FractionBox[
         RowBox[{"dP", " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}], 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
         RowBox[{"dG", " ", "-", " ", 
          RowBox[{"dP", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]], "]"}], "-", 
       "\[Pi]"}]}], "]"}]}], "]"}], " "}]}], "Input",
