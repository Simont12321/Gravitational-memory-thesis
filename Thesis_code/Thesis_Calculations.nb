Cell[BoxData[
 RowBox[{
  RowBox[{"NestedComm", "[", 
   RowBox[{"A_", ",", "B_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"n", "==", "1"}], ",", 
    RowBox[{"Comm", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ",", 
    RowBox[{"Comm", "[", 
     RowBox[{"A", ",", 
      RowBox[{"NestedComm", "[", 
       RowBox[{"A", ",", "B", ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
