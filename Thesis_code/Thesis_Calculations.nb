Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Comm", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"A", ".", "B"}], "-", 
    RowBox[{"B", ".", "A"}]}]}]}]], "Input",
 CellChangeTimes->{{3.962870909090201*^9, 3.962870909390386*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"cb4ab394-f7e9-499b-acdc-794ad0b096b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NestedComm", "[", 
   RowBox[{"A_", ",", "B_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"n", "==", "1"}], ",", 
    RowBox[{"Comm", "[", 
     RowBox[{"A", ",", "B"}], "]"}], ",", 
    RowBox[{"Comm", "[", 
     RowBox[{"A", ",", 
      RowBox[{"NestedComm", "[", 
       RowBox[{"A", ",", "B", ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.96287091777459*^9, 3.9628709177833157`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"7875ae03-f35b-4f10-be76-80426e02ab06"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<", "8"}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"i", "!"}]}], "*", 
      RowBox[{"NestedComm", "[", 
       RowBox[{"My", ",", "P", ",", "i"}], "]"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9628709310634747`*^9, 
  3.9628709310728607`*^9}},ExpressionUUID->"bf112a71-0ae2-4201-b86b-\
4ef901acb755"],

