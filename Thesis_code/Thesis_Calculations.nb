Cell[TextData[{
 "\nThe trig expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"e4387975-fb61-47c8-b9f7-7d16a10dca20"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"96027943-f71d-4328-bae3-23dd2e0835eb"],
 ", and  Cos[4 ArcTan[x]] appears frequently in our code. Here, we define \
functions which can be used to simplify these expressions automatically. "
}], "Text",
 CellChangeTimes->{{3.949739423592511*^9, 3.9497394558185377`*^9}, {
   3.949933007006098*^9, 3.949933017778038*^9}, {3.949933057673617*^9, 
   3.949933057673704*^9}, {3.949941923464172*^9, 3.94994192346424*^9}, {
   3.951693881789442*^9, 3.951693883957716*^9}, {3.953296099694847*^9, 
   3.953296167006443*^9}, {3.953296293399352*^9, 3.953296304992146*^9}, 
   3.95329650206572*^9, {3.9533004569809713`*^9, 3.953300475140843*^9}, {
   3.953302202843472*^9, 
   3.953302220169775*^9}},ExpressionUUID->"91c90e8c-3606-440f-880c-\
f5a28f1f49b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SinSimp", "[", 
    RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"2", "*", 
     FractionBox["opp", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["adj", "2"], "+", 
        SuperscriptBox["opp", "2"]}], "]"}]], "*", 
     FractionBox["adj", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox["adj", "2"], "+", 
        SuperscriptBox["opp", "2"]}], "]"}]]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Simplifies", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", 
      RowBox[{"ArcTan", "[", 
       FractionBox["opp", "adj"], "]"}]}], "]"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sin", 
     RowBox[{"(", 
      RowBox[{"2", "x"}], ")"}]}], " ", "=", " ", 
    RowBox[{"2", "CosxSinx"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CosSimp", "[", 
    RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["adj", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          SuperscriptBox["adj", "2"], "+", 
          SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["opp", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          SuperscriptBox["adj", "2"], "+", 
          SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Simplifies", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"2", 
      RowBox[{"ArcTan", "[", 
       FractionBox["opp", "adj"], "]"}]}], "]"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Cos", 
     RowBox[{"(", 
      RowBox[{"2", "x"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["Cos", "2"], 
      RowBox[{"(", "x", ")"}]}], " ", "-", " ", 
     RowBox[{
      SuperscriptBox["Sin", "2"], 
      RowBox[{"(", "x", ")"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CosSimp4AT", "[", 
   RowBox[{"opp_", ",", " ", "adj_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"8", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["adj", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "4"]}], "-", 
   RowBox[{"8", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["adj", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["adj", "2"], "+", 
         SuperscriptBox["opp", "2"]}], "]"}]], ")"}], "2"]}], "+", "1", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"4", "x"}], "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "-", 
       RowBox[{"8", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "x", "]"}], "2"]}], "+", "1"}]}], ")"}], 
    "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.9533004772522707`*^9, 3.9533004774976482`*^9}, {
