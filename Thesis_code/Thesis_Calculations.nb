Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"H3DIsoApprox", "[", 
    RowBox[{
    "t_", ",", " ", "tP_", ",", " ", "\[Theta]_", ",", " ", "\[Phi]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
       SuperscriptBox[
