                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["dG", "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], "+", 
                    RowBox[{"2", " ", "dG", " ", 
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], " ", 
                    RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    FractionBox[
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"t", "-", "tP"}], ")"}], "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
