   RowBox[{
    RowBox[{"+", " ", "polarized"}], " ", "wave"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"G", " ", "=", " ", 
    RowBox[{"{", 
