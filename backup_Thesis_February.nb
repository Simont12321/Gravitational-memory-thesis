Cell[TextData[{
 "z = \[Zeta] ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "d5a14cbb-9538-4b12-8b46-63e2aeebd2cf"],
 ". The negative cancels out since we use opposite integral bounds. I don\
\[CloseCurlyQuote]t know what to do about ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],ExpressionUUID->
  "8e1a6fb6-7560-42d8-ae17-7a4b848ea9d0"],
 " but I think it drops out when converting the integral over d\[Lambda] to \
dt, d\[Lambda] = ",
 Cell[BoxData[
  FormBox[
   FractionBox["dt", 
    SubscriptBox["\[Omega]", "0"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "556aed0d-9b50-4d37-9b5e-df7286526ae4"],
 "? \n\[Zeta] is directly proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], TraditionalForm]],
  ExpressionUUID->"8a2342fd-495c-42ad-9886-3b4100a34e3e"],
 ", meaning it is 0 for small \[Theta]. \nA simplifying assumption we may be \
able to make is that dG is small. This is the distance to the gravitational \
wave source. "
}], "Text",
 CellChangeTimes->{{3.949319487116178*^9, 3.949319487726769*^9}, {
  3.94932132548379*^9, 3.949321421381949*^9}, {3.949321492356839*^9, 
  3.949321525855308*^9}, {3.949321635611619*^9, 3.94932163692346*^9}, {
